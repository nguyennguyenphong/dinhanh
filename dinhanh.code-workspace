{
	"folders": [
		{
			"path": "."
		}
	],
	"tasks": {
		"version": "2.0.0",
		"inputs": [
			{
				"id": "branchName",
				"type": "promptString",
				"description": "Enter the name of the new branch to create (e.g., feature/login):"
			},
			{
				"id": "prTitle",
				"type": "promptString",
				"description": "Enter the title for the Pull Request:"
			},
			{
				"id": "commitMessage",
				"type": "promptString",
				"description": "Enter the git commit message:"
			}
		],
		"tasks": [
			{
				"label": "1. Create new branch (Git Branch)",
				"type": "shell",
				"command": "git checkout -b '${input:branchName}'",
				"problemMatcher": [],
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": true,
					"panel": "shared"
				}
			},
			{
				"label": "2. Create Pull Request (GitHub CLI)",
				"type": "shell",
				"command": "gh pr create --title '${input:prTitle}' --body ''",
				"problemMatcher": [],
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": true,
					"panel": "shared"
				}
			},
			{
				"label": "3. Trigger CI/CD (GitHub Action)",
				"type": "shell",
				"command": "gh workflow run",
				"problemMatcher": [],
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": true,
					"panel": "shared"
				}
			},
			{
				"label": "4. Lint and Run Tests (Frontend)",
				"type": "shell",
				"command": "npm run lint && npm run test",
				"problemMatcher": [],
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": true,
					"panel": "shared"
				}
			},
			{
				"label": "5. Run Django Check",
				"type": "shell",
				"command": "./venv/bin/python manage.py check",
				"problemMatcher": [],
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": true,
					"panel": "shared"
				}
			},
			{
				"label": "6. Run Flake8 Code Quality Check",
				"type": "shell",
				"command": "./venv/bin/flake8 .",
				"problemMatcher": [],
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": true,
					"panel": "shared"
				}
			},
			{
				"label": "7. Run Database Migrations",
				"type": "shell",
				"command": "./venv/bin/python manage.py makemigrations && ./venv/bin/python manage.py migrate",
				"problemMatcher": [],
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": true,
					"panel": "shared"
				}
			},
			{
				"label": "8. Build Production Assets (Vite)",
				"type": "shell",
				"command": "npm run build",
				"problemMatcher": [],
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": true,
					"panel": "shared"
				}
			},
			{
				"label": "9. Start Development Server (Django)",
				"type": "shell",
				"command": "./venv/bin/python manage.py runserver",
				"problemMatcher": [],
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": true,
					"panel": "shared"
				}
			},
			{
				"label": "10. Create Django Superuser",
				"type": "shell",
				"command": "./venv/bin/python manage.py createsuperuser",
				"problemMatcher": [],
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": true,
					"panel": "shared"
				}
			},
			{
				"label": "11. Clean Pycache & Temporary Files",
				"type": "shell",
				"command": "find . -name \"*.pyc\" -delete && find . -name \"__pycache__\" -delete",
				"problemMatcher": [],
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": true,
					"panel": "shared"
				}
			},
			{
				"label": "12. Git Commit, Push & Trigger CI/CD",
				"type": "shell",
				"command": "git add . && git commit -m '${input:commitMessage}' && git push origin HEAD && gh workflow run",
				"problemMatcher": [],
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": true,
					"panel": "shared"
				}
			}
		]
	},
	"settings": {}
}